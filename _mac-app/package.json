{
  "name": "noams-game-hub",
  "version": "1.0.0",
  "description": "Noam's Game Hub — free games, right on your Mac",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64 --x64 --publish never"
  },
  "keywords": [],
  "author": "Noam",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "Noam's Game Hub",
  "build": {
    "appId": "com.noamtoder.gamehub",
    "productName": "Noam's Game Hub",
    "copyright": "Copyright © 2026 Noam",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "he"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": null,
      "hardenedRuntime": false,
      "darkModeSupport": true
    }
  }
}